{
    "$schema": "../gen/schemas/desktop-capability.json",
    "identifier": "main-capability",
    "description": "Capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "dialog:allow-open",
        "dialog:allow-save",
        "dialog:allow-message",
        "dialog:allow-ask",
        "dialog:allow-confirm",
        "fs:allow-read",
        "fs:allow-write",
        "fs:allow-exists",
        "fs:allow-mkdir",
        "fs:allow-stat",
        {
            "identifier": "fs:scope",
            "allow": [
                "$APPDATA/**",
                "$DESKTOP/**",
                "$DOCUMENT/**",
                "$DOWNLOAD/**",
                "$PICTURE/**",
                "$HOME/**",
                "/**"
            ]
        }
    ]
}
{
  "name": "xl-converter",
  "version": "1.0.0",
  "description": "Easy-to-use image converter for modern formats",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"wait-on dist/main.js dist/renderer/index.html && electron .\"",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "npm run copy:static && tsc -p tsconfig.renderer.json --watch",
    "copy:static": "node scripts/copy-static.js",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "npm run copy:static && tsc -p tsconfig.renderer.json",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "lint": "biome check .",
    "format": "biome format .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand"
  },
  "keywords": [
    "image",
    "converter",
    "jpegli",
    "jpeg-xl",
    "avif",
    "webp"
  ],
  "author": "XL Converter Team",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "execa": "^9.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "trash": "^10.0.0"
  },
  "build": {
    "appId": "eu.codepoems.xl-converter",
    "productName": "XL Converter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "binaries/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}

{
  "name": "jpeglic-converter",
  "version": "1.2.0",
  "description": "Easy-to-use image converter for modern formats",
  "keywords": [
    "converter",
    "image",
    "jpeg",
    "jpegli"
  ],
  "license": "MIT",
  "author": "Volodymyr Peretiatko",
  "repository": {
    "type": "git",
    "url": "https://github.com/djbob2000/home-archive-converter.git"
  },
  "type": "module",
  "main": "src/renderer/main.tsx",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=warn .",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives-severity=warn --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "clsx": "^2.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt",
      "oxlint"
    ],
    "*.{json,css,html,md}": [
      "oxfmt"
    ]
  }
}
